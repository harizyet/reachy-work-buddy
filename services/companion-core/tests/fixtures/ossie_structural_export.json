  "metrics": [
    {
      "name": "open_tasks",
      "expression": {
        "dialects": [
          {
            "dialect": "ANSI_SQL",
            "expression": "COUNT(CASE WHEN tasks.status = 'open' THEN 1 END)"
          }
        ]
      },
      "description": "Tasks that are not done.",
      "datatype": "Integer"
    },
    {
      "name": "pending_reminders",
      "expression": {
        "dialects": [
          {
            "dialect": "ANSI_SQL",
            "expression": "COUNT(CASE WHEN reminders.status = 'pending' THEN 1 END)"
          }
        ]
      },
      "description": "Reminders not yet completed.",
      "datatype": "Integer"
    },
    {
      "name": "active_memories",
      "expression": {
        "dialects": [
          {
            "dialect": "ANSI_SQL",
            "expression": "COUNT(CASE WHEN memories.forgotten_at IS NULL AND (memories.expires_at IS NULL OR memories.expires_at > CURRENT_TIMESTAMP) THEN 1 END)"
          }
        ]
      },
      "description": "Memories that are neither forgotten nor expired.",
      "datatype": "Integer"
    },
    {
      "name": "meetings_total",
      "expression": {
        "dialects": [
          {
            "dialect": "ANSI_SQL",
            "expression": "COUNT(meetings.id)"
          }
        ]
      },
      "description": "All stored meetings, whatever their processing state.",
      "datatype": "Integer"
    },
    {
      "name": "document_chunks_total",
      "expression": {
        "dialects": [
          {
            "dialect": "ANSI_SQL",
            "expression": "COUNT(document_chunks.id)"
          }
        ]
      },
      "description": "All stored document chunks.",
      "datatype": "Integer"
    }
  ],
  "custom_extensions": [
    {
      "vendor_name": "REACHY",
      "data": "{\"not_expressed\":[\"entities\",\"typed relationships\",\"provenance\",\"confidence\",\"temporal validity and supersession\",\"evidence links\"],\"note\":\"Structural description only. Reachy's knowledge ontology is not represented in this model.\"}"
    }
  ]
