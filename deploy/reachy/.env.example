# Robot-side environment for scripts/start-reachy.sh / start-jetson.sh.
# Copy to .env next to this file (or pass --env-file elsewhere) and fill
# in real values. Keep this file permission-restricted (chmod 600) — it
# holds this robot's authentication token. See docs/adr/0019-robot-
# initiated-hub-connectivity.md and deploy/reachy/README.md.

# A stable hub hostname reachable from this machine (LAN/VPN/Tailscale) —
# not an IP that might change. https:// in production; the WS client
# derives ws:// or wss:// from this. See ADR 0019: "Configure a stable
# hub hostname and per-robot credential, not a robot address in the hub."
# Includes the /hub path prefix Caddy fronts reachy-hub with (see
# deploy/homelab/Caddyfile) — reachy-hub itself is not exposed directly.
HUB_WS_URL=http://reachy-hub.example.internal:8080/hub

# This robot's logical identity and its credential. Must exactly match
# one entry in the hub's ROBOT_TOKENS (deploy/homelab/.env) — same
# robot_id, same token. Generate a random token per robot, e.g.
# `openssl rand -hex 32`; never reuse one across robots.
ROBOT_ID=nano-1
ROBOT_TOKEN=change-me-to-match-the-hub-s-ROBOT_TOKENS-entry

# Phase 22 HONEST LIMITATION: the ADR 0019 WSS connection above is
# connectivity/liveness only as of this writing — semantic command
# routing (behaviour/camera/audio) over it is not yet implemented (see
# HANDOVER.md). Real commands still go over the *old* HTTP path
# (EmbodimentClient -> this robot's own HTTP server), which still needs
# an inbound-reachable address registered with the hub the old way. This
# is the actual reason ROBOT_HTTP_BASE_URL below still exists — remove it
# once command routing moves onto the WSS connection and ADR 0019's
# no-inbound-robot-ports goal is actually reached, not before.
# Must be reachable FROM the homelab (LAN/VPN/Tailscale) on
# REACHY_EMBODIMENT_PORT below (8100 by default — NOT 8000, see that
# variable's comment for why).
ROBOT_HTTP_BASE_URL=http://nano-1.example.internal:8100

# Real hardware, not simulation — see services/reachy-embodiment/src/
# reachy_embodiment/robot.py's ReachyDaemonBackend. reachy-mini-daemon
# must already be running (see reachy-mini-daemon.service in this
# directory) before reachy-embodiment starts, or REACHY_DAEMON_URL below
# won't be reachable and `connected` will honestly report false.
ROBOT_BACKEND=reachy_daemon
# reachy-mini-daemon binds 127.0.0.1 ONLY by default (confirmed live on
# the Nano) and refuses connections from any other interface — including
# a bridge-networked container's host.docker.internal gateway, which an
# earlier version of this file assumed would work and doesn't.
# start-reachy.sh therefore runs reachy-embodiment with --network host
# (same network namespace as the daemon, not Docker's default bridge),
# so 127.0.0.1 here genuinely reaches the daemon directly. Only override
# if running reachy-embodiment natively (not containerized) on the same
# host, where 127.0.0.1 is correct for the same reason.
REACHY_DAEMON_URL=http://127.0.0.1:8000

# Host port reachy-embodiment's own HTTP API listens on. Confirmed live
# on the Jetson Nano: reachy-mini-daemon itself already binds host
# 127.0.0.1:8000 (`ss -tlnp`), so reachy-embodiment can't also use 8000 —
# with --network host there's no container-internal/external port
# mapping to hide behind, a same-port bind would collide directly.
# start-reachy.sh reads this (falling back to 8100 if unset); --port
# overrides both.
REACHY_EMBODIMENT_PORT=8100

# Phase 24c (ADR 0023): lets the owner start a microphone conversation
# through this robot from the operator UI's Chat view. Off by default —
# with this false the robot never offers capture. When true, the launcher
# shares the daemon user's ~/.asoundrc and IPC namespace with the
# container (see docs/deployment.md#robot-voice-conversation). Changing
# it requires `docker rm -f reachy-embodiment` before the next start.
VOICE_CONVERSATION_ENABLED=false
