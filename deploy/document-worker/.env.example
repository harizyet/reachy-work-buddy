# Copy to .env (gitignored) on the worker host. The token must equal DOCUMENT_WORKER_TOKEN in companion-core's environment; generate it with: openssl rand -hex 32
DOCUMENT_WORKER_TOKEN=
# This host's private (LAN or tailnet) address. Not 0.0.0.0.
DOCUMENT_WORKER_BIND=
DOCUMENT_WORKER_PORT=18700
# Directory holding MinerU-4_models_onnx and MinerU2.5-Pro-2605-1.2B-GGUF (verify with ./verify-models.sh)
DOCUMENT_WORKER_MODELS_DIR=
DOCUMENT_WORKER_MEMORY=6g
DOCUMENT_WORKER_CPUS=4
