# Reverse proxy in front of the homelab services, per docs/plan.md §6 Phase 4
# ("reverse proxy via Docker Compose"). Path-based routing only — no TLS
# termination here. Phase 16/ADR 0013 added authentication for reachy-hub's
# remote-control surface (/robots/*, /webrtc/telepresence/offer,
# /robots/*/speak — see reachy_hub/app.py's require_remote_auth and
# REMOTE_UI_TOKEN), which is what docs/plan.md §9's "Authenticate all
# remote Hub endpoints" asked for. TLS is still not implemented — do not
# expose this port to the public Internet as configured here; real
# "overseas" remote use needs a VPN/tunnel (e.g. Tailscale) or TLS added at
# this Caddy layer, neither of which has anything to verify against in this
# environment.

:8080 {
	handle_path /hub/* {
		reverse_proxy reachy-hub:8000
	}

    # Operator settings/usage are accessible only through authenticated hub routes.
    @operator_internal path /core/settings/* /core/llm/*
    handle @operator_internal {
        respond "Not found" 404
    }

	handle_path /core/* {
		reverse_proxy companion-core:8000
	}

	handle /health {
		respond "ok" 200
	}
}
