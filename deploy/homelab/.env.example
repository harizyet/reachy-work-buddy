POSTGRES_USER=reachy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reachy_hub

# Optional (Phase 7): leave unset to run without Telegram.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather
# TELEGRAM_DEFAULT_USER_ID=hariz

# Optional (ADR 0011): leave unset for the real ~10-minute email send
# delay. Shorten for local/dev testing so the send path doesn't need a
# genuine 10-minute wait every time it's exercised.
# EMAIL_SEND_DELAY_SECONDS=10
# EMAIL_DISPATCH_INTERVAL_SECONDS=2

# Optional (Phase 16/ADR 0013): leave unset to disable remote telepresence
# entirely (every /robots/*, /webrtc/telepresence/offer, and /robots/*/speak
# call 503s — fail closed). Set a real random secret to enable the
# telepresence UI (clients/web-pwa/telepresence.html); pasted into that
# page once and kept in the browser's localStorage from then on.
# REMOTE_UI_TOKEN=change-me-to-a-real-secret

# Phase 19: single-owner dashboard at /hub/ui/. Bootstrap only creates an
# account if none exists; changing these later does not reset its password.
# Set a strong password and independent random session-signing key.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET_KEY=
# Set true behind HTTPS. False is for this Compose stack's local HTTP/VPN.
SESSION_COOKIE_SECURE=false

# Phase 22/ADR 0019: robot credentials for the WSS control connection.
# Leave unset to run with `--simulation` only (reachy-embodiment's HTTP
# path doesn't need this at all). Required for a real robot: JSON object
# of {robot_id: token} — pick a robot_id and generate a random token per
# robot, e.g. `ROBOT_TOKENS={"nano-1":"$(openssl rand -hex 32)"}`, then
# put the *same* robot_id/token pair in the robot-side ROBOT_ID/ROBOT_TOKEN
# env vars (see deploy/reachy/README.md and scripts/start-reachy.sh).
# In-memory only for this first slice — a hub restart needs this set
# again, it does not persist to Postgres yet (see robot_credential_store.py).
# ROBOT_TOKENS={"nano-1":"change-me-to-a-real-random-token"}

# Phase 24e item 5 (ADR 0023 addendum): while a robot speaks a reply, a
# held open palm in front of its camera stops the reply and it listens
# again. The robot uploads frames only during playback; the hub classifies
# them in memory and never stores them. Not physically accepted yet.
# PALM_STOP_ENABLED=false

# Robot voice limits (ADR 0023). Unset keeps the defaults. The continuation
# window is how long, after a segment that sounds unfinished, the robot waits
# for speech to resume before asking for an answer (0-5000 ms, default 1500);
# only trailing-off turns pay it. The session maximum (default 600 s, up to
# 3600) must be at least 1800 for the 30-minute sustained-use check.
# VOICE_CONTINUATION_WINDOW_MS=1500
# VOICE_END_OF_SPEECH_SILENCE_MS=700
# VOICE_MAX_SESSION_SECONDS=600

# Phase 22: production email. Leave unset to run with `--simulation`
# (routes through the local Mailpit container, a fake mailbox — never a
# real send). Set these to a real SMTP relay/smarthost for production;
# Authenticated relays use STARTTLS with the credential settings below.
# SMTP_HOST=smtp.example.internal
# SMTP_PORT=25
# SMTP_FROM=reachy@example.com

# Phase 23: required for migration and core; separate from SESSION_SECRET_KEY.
# Generate using the deployment guide. Absolute paths avoid Compose path ambiguity.
# File must be owner-readable only (0600); back it up separately from Postgres.
SECRET_KEY_FILE=/absolute/path/to/.env.secret-keys.json
# Optional SMTP authentication; ref takes precedence over bootstrap password.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECRET_REF=

# Google Accounts: independent random hub/core service credential.
# Required for production hub/core startup, even before linking Google.
# Work-data HTTP routes require owner login; core data requires this token.
ACCOUNTS_SERVICE_TOKEN=
OWNER_USER_ID=default-user
# Optional: only this private Telegram chat may use the owner account.
# Must belong to the owner; GOOGLE linking never enables arbitrary bot chats.
TELEGRAM_OWNER_CHAT_ID=

# Phase 24 cleanup: NOT needed for ordinary use. scripts/start-homelab.sh
# auto-generates and persists this internal deployment secret for the
# bundled SearXNG container (deploy/homelab/.env.searxng-secret, 0600) —
# it's infrastructure, not a user credential, so most operators never set
# this. Only uncomment/set it if you deliberately want a fixed value
# (e.g. shared across hosts) instead of the auto-generated one.
# SEARXNG_SECRET_KEY=
