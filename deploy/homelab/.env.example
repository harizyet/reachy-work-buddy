POSTGRES_USER=reachy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reachy_hub

# Optional (Phase 7): leave unset to run without Telegram.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather
# TELEGRAM_DEFAULT_USER_ID=hariz

# Optional (ADR 0011): leave unset for the real ~10-minute email send
# delay. Shorten for local/dev testing so the send path doesn't need a
# genuine 10-minute wait every time it's exercised.
# EMAIL_SEND_DELAY_SECONDS=10
# EMAIL_DISPATCH_INTERVAL_SECONDS=2

# Optional (Phase 16/ADR 0013): leave unset to disable remote telepresence
# entirely (every /robots/*, /webrtc/telepresence/offer, and /robots/*/speak
# call 503s — fail closed). Set a real random secret to enable the
# telepresence UI (clients/web-pwa/telepresence.html); pasted into that
# page once and kept in the browser's localStorage from then on.
# REMOTE_UI_TOKEN=change-me-to-a-real-secret

# Phase 19: single-owner dashboard at /hub/ui/. Bootstrap only creates an
# account if none exists; changing these later does not reset its password.
# Set a strong password and independent random session-signing key.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET_KEY=
# Set true behind HTTPS. False is for this Compose stack's local HTTP/VPN.
SESSION_COOKIE_SECURE=false
