__pycache__/
*.pyc
.venv/
.env
.env.*
# .env.* above is meant to catch real secret files (.env.local,
# .env.production, etc.) — not committed template/example files. Without
# this negation, `.env.*` silently swallows any NEW `.env.example` added
# in a directory other than deploy/homelab (whose copy predates this
# gitignore rule and so stayed tracked by accident, not by working as
# intended). Found live: deploy/reachy/.env.example was silently untracked
# during Phase 22 until this was added — `git status` never mentioned it.
!.env.example
!**/.env.example
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/
vendor/

# Private real-meeting recordings used by the opt-in end-to-end meeting test
test/

# Blind-review answer keys stay local until the owner has rated (the matching KEY.sha256 is committed as a seal)
services/companion-core/benchmarks/answer_quality/blind_review/*/KEY-*.json
